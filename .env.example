APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Queries slower than this (ms) are logged as warnings. Raise in production if
# the warning volume is too high.
SLOW_QUERY_THRESHOLD_MS=200

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# FastNet Stays — app-real settings.
#
# PRODUCTION (Railway) checklist for these:
#  1. APP_URL must be the PUBLIC API origin, e.g.
#     https://api.fastnetstays.com — every stored image URL is minted as
#     APP_URL/storage/..., so a localhost value here silently breaks all
#     uploaded images. The app logs a critical at boot if this is wrong.
#  2. Attach a Railway volume at storage/app/public, or every upload is
#     lost on the next deploy (Railway disk is ephemeral).
#  3. Migrations run themselves at container boot (docker/entrypoint.sh).
#  4. There is no admin self-registration. After deploy, provision one with:
#       php artisan admin:create --email=you@site.com
# ─────────────────────────────────────────────────────────────

# Public web origin, used in email links.
FRONTEND_URL=https://fastnetstays.com

# Mapbox (also mirrored to the frontend via GET /api/map-config).
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Email delivery via Resend. Without RESEND_API_KEY the API answers success
# but nothing is ever sent — check logs for "RESEND_API_KEY is not set".
RESEND_API_KEY=
# Optional per-purpose senders; each falls back to the shown address.
MAIL_FROM_WELCOME=welcome@fastnetstays.com
MAIL_FROM_SECURITY=security@fastnetstays.com
MAIL_FROM_BOOKINGS=bookings@fastnetstays.com
MAIL_FROM_SUPPORT=support@fastnetstays.com
MAIL_FROM_CAREERS=careers@fastnetstays.com

# SMS delivery via NextSMS (https://messaging-service.co.tz). Without these,
# sendSms() fails closed and logs "Missing NEXTSMS_API_KEY or
# USERNAME/PASSWORD". Sender ID must be one approved for your account.
NEXTSMS_API_KEY=
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=NEXTSMS

# Mobile-money payouts (AzamPay). Sandbox credentials come from the sandbox
# portal (https://developers.azampay.co.tz/) after choosing API Integration.
# Token endpoint: POST {authenticator(-sandbox)}.azampay.co.tz/
# AppRegistration/GenerateToken. Leave AZAMPAY_TOKEN empty: the app mints and
# refreshes it via GenerateToken itself. AZAMPAY_API_KEY is optional and only
# sent as an extra X-API-Key header when set.
AZAMPAY_ENV=sandbox
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_TOKEN=
